---
import SiteLayout from './SiteLayout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import 'katex/dist/katex.min.css';
import '../styles/field-note.css';

interface SectionLink { id: string; label: string; }
interface Props {
  title: string;
  description: string;
  kicker: string;
  headline: string;
  dek: string;
  image: string;
  imageAlt: string;
  tone: 'technical' | 'frontier';
  issue: string;
  readingTime: string;
  published: string;
  updated: string;
  sections: SectionLink[];
}

const {
  title, description, kicker, headline, dek, image, imageAlt, tone,
  issue, readingTime, published, updated, sections
} = Astro.props;

const updatedLabel = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC'
}).format(new Date(`${updated}T00:00:00Z`));
---

<SiteLayout
  {title}
  {description}
  {image}
  {imageAlt}
  type="article"
  active="notes"
  {published}
  {updated}
>
  <main id="main" class:list={['essay', `essay-${tone}`]}>
    <header class="essay-hero">
      <div class="essay-identity">
        <a href="/blog/MetaMind/">MetaMind dossier</a>
        <span>{issue}</span>
      </div>
      <div class="essay-hero-grid">
        <div class="essay-hero-copy" data-reveal>
          <p class="essay-kicker">{kicker}</p>
          <h1>{headline}</h1>
          <p class="essay-dek">{dek}</p>
          <div class="essay-meta">
            <span>By Xuanming Zhang</span>
            <span>{readingTime}</span>
            <span>Updated {updatedLabel}</span>
          </div>
        </div>
        <div class="essay-signal" data-reveal>
          {tone === 'technical' ? (
            <>
              <img src="/assets/images/metamind-technical-instrument-v2.webp" width="1920" height="1080" alt="Three connected stages for hypothesis generation, constraint-based selection, and response validation" />
              <div class="signal-caption"><span>System trace / 01</span><strong>Infer → Constrain → Validate</strong><small>Memory closes the loop.</small></div>
            </>
          ) : (
            <>
              <img src="/assets/images/metamind-hypothesis-field-v2.webp" width="1920" height="1080" alt="Multiple cognitive hypotheses converging into an evolvable capability" />
              <div class="signal-caption"><span>Cognitive frontier / 02</span><strong>Scaffold → Learn → World</strong><small>From explicit process to learned capability.</small></div>
            </>
          )}
        </div>
      </div>
    </header>

    <div class="essay-shell">
      <aside class="essay-toc" aria-label="Article contents">
        <p>Inside this field note</p>
        <ol>
          {sections.map((section, index) => <li><a href={`#${section.id}`}><span>{String(index + 1).padStart(2, '0')}</span>{section.label}</a></li>)}
        </ol>
        <div class="essay-source">
          <span>Primary source</span>
          <a href="https://arxiv.org/abs/2505.18943">Paper ↗</a>
          <a href="https://github.com/XMZhangAI/MetaMind">Code ↗</a>
        </div>
      </aside>

      <article class="essay-content">
        <slot />
      </article>
    </div>

    <nav class="essay-next" aria-label="Continue reading">
      {tone === 'technical' ? (
        <a href="/blog/MetaMind/cognitive-frontier/"><span>Continue to field note 02</span><strong>From cognitive scaffolds<br />to evolvable capability.</strong><i>→</i></a>
      ) : (
        <a href="/blog/MetaMind/technical-contribution/"><span>Return to field note 01</span><strong>Read the verified technical<br />contribution behind the agenda.</strong><i>←</i></a>
      )}
    </nav>

    <SiteFooter />
  </main>
</SiteLayout>
