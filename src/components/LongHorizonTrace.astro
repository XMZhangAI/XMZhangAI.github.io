---
const turns = ['T1', 'T2', 'T3', 'T4', 'T5', 'T6'];
const series = [
  { key: 'local', label: 'Local response quality', values: [94, 94, 93, 92, 91, 90] },
  { key: 'trust', label: 'Relational trust', values: [92, 89, 80, 64, 47, 34] },
  { key: 'agency', label: 'User agency', values: [91, 87, 74, 55, 36, 23] }
] as const;
const point = (value: number, index: number) => `${80 + index * 104},${42 + (100 - value) * 2.16}`;
const points = (values: readonly number[]) => values.map(point).join(' ');
---

<figure class="mechanism trajectory-audit" aria-labelledby="trajectory-audit-title">
  <header>
    <div>
      <span>Trajectory audit / illustrative trace</span>
      <strong id="trajectory-audit-title">The response still looks good.<br />The relationship does not.</strong>
    </div>
    <p>Single-turn quality remains above 90 while trust and agency deteriorate across repeated interaction.</p>
  </header>

  <div class="trajectory-chart">
    <svg viewBox="0 0 680 310" role="img" aria-labelledby="trace-title trace-desc">
      <title id="trace-title">Local response quality compared with relational trust and user agency over six turns</title>
      <desc id="trace-desc">Local response quality changes from 94 to 90, relational trust from 92 to 34, and user agency from 91 to 23.</desc>
      <g class="trace-grid">
        {[100, 75, 50, 25, 0].map((value) => (
          <g>
            <line x1="70" x2="610" y1={42 + (100 - value) * 2.16} y2={42 + (100 - value) * 2.16} />
            <text x="58" y={46 + (100 - value) * 2.16} text-anchor="end">{value}</text>
          </g>
        ))}
      </g>
      <g class="turn-labels">
        {turns.map((turn, index) => <text x={80 + index * 104} y="286" text-anchor="middle">{turn}</text>)}
      </g>
      {series.map((item) => (
        <g class={`trace-series ${item.key}`}>
          <polyline points={points(item.values)} />
          {item.values.map((value, index) => <circle cx={80 + index * 104} cy={42 + (100 - value) * 2.16} r="4.5" />)}
        </g>
      ))}
      <line class="failure-line" x1="392" x2="392" y1="30" y2="258" />
      <text class="failure-label" x="402" y="58">trajectory warning</text>
    </svg>
  </div>

  <div class="trajectory-legend" aria-label="Chart legend">
    {series.map((item) => (
      <span class={item.key}><i></i>{item.label}<b>{item.values[0]} → {item.values.at(-1)}</b></span>
    ))}
  </div>

  <footer>
    <div><span>Turn-level judge</span><strong>6 / 6 pass</strong></div>
    <div><span>Trajectory judge</span><strong>Failure visible at T4</strong></div>
    <p>The object of evaluation is not an isolated answer, but the state transition induced by a sequence of answers.</p>
  </footer>
</figure>

<style>
  .trajectory-audit { min-height: 680px; padding: clamp(28px, 4.5vw, 64px); display: flex; flex-direction: column; color: #edf7f5; background: #071c24; border-left: 1px solid rgba(255,255,255,.14); }
  header { display: grid; grid-template-columns: minmax(0,1.15fr) minmax(220px,.65fr); gap: 30px; align-items: end; }
  header div { display: grid; gap: 12px; }
  header span, footer span { color: #6f9299; font: 780 .55rem/1.4 var(--sans); letter-spacing: .1em; text-transform: uppercase; }
  header strong { font: 420 clamp(1.9rem,3.3vw,3.35rem)/.98 var(--serif); letter-spacing: -.03em; }
  header p { margin: 0; color: #8ca5aa; font-size: .67rem; line-height: 1.6; }
  .trajectory-chart { margin-top: 42px; padding: 18px; background: #0a2630; border: 1px solid #1c4650; }
  svg { width: 100%; height: auto; display: block; font-family: var(--sans); }
  .trace-grid line { stroke: #264851; stroke-width: 1; }
  .trace-grid text, .turn-labels text { fill: #6f8d94; font-size: 10px; }
  .trace-series polyline { fill: none; stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; }
  .trace-series circle { stroke: #0a2630; stroke-width: 2.5; }
  .trace-series.local polyline, .trace-series.local circle { stroke: #f2f0e8; fill: #f2f0e8; }
  .trace-series.trust polyline, .trace-series.trust circle { stroke: #50d7c8; fill: #50d7c8; }
  .trace-series.agency polyline, .trace-series.agency circle { stroke: #ffbe5c; fill: #ffbe5c; }
  .failure-line { stroke: #ef6a6a; stroke-width: 1; stroke-dasharray: 4 5; }
  .failure-label { fill: #ef8b8b; font-size: 9px; font-weight: 800; letter-spacing: .8px; text-transform: uppercase; }
  .trajectory-legend { margin-top: 18px; display: grid; grid-template-columns: repeat(3,1fr); gap: 10px; }
  .trajectory-legend span { min-width: 0; display: grid; grid-template-columns: 22px 1fr auto; gap: 8px; align-items: center; color: #9bb0b4; font-size: .55rem; }
  .trajectory-legend i { height: 3px; display: block; background: currentColor; }
  .trajectory-legend b { color: #dce8e7; font-family: var(--serif); font-size: .72rem; font-weight: 500; }
  .trajectory-legend .local { color: #f2f0e8; }
  .trajectory-legend .trust { color: #50d7c8; }
  .trajectory-legend .agency { color: #ffbe5c; }
  footer { margin-top: auto; padding-top: 28px; display: grid; grid-template-columns: .55fr .72fr 1.3fr; gap: 20px; border-top: 1px solid rgba(255,255,255,.14); }
  footer div { display: grid; gap: 8px; }
  footer strong { color: #edf7f5; font: 480 1.08rem/1.1 var(--serif); }
  footer p { margin: 0; color: #819ba1; font-size: .59rem; line-height: 1.55; }
  @media (max-width: 760px) {
    .trajectory-audit { min-height: 620px; padding: 32px 18px; border-left: 0; border-top: 1px solid rgba(255,255,255,.14); }
    header, footer { grid-template-columns: 1fr; align-items: start; }
    .trajectory-chart { width: 100%; max-width: 100%; padding: 10px 8px; overflow: hidden; }
    svg { width: 100%; min-width: 0; }
    .trajectory-legend { grid-template-columns: 1fr; }
  }
</style>
