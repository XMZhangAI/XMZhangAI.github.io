---
import katex from 'katex';

interface Props {
  formula: string;
  label: string;
  tag?: string;
}

const { formula, label, tag } = Astro.props;
const rendered = katex.renderToString(formula, {
  displayMode: true,
  throwOnError: true,
  strict: 'warn',
  output: 'htmlAndMathml'
});
---

<div class="equation" aria-label={label}>
  <div class="equation-row">
    <div class="equation-katex" set:html={rendered}></div>
    {tag && <span class="equation-tag" aria-hidden="true">{tag}</span>}
  </div>
  <div class="equation-explanation"><slot /></div>
</div>
