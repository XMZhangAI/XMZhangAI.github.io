---
const dimensions = [
  { label: 'Emotion', definition: 'Infer how another person feels from context and events.', human: 86.4, base: 75.7, meta: 78.7 },
  { label: 'Desire', definition: 'Recover goals, preferences, and wanted outcomes.', human: 78.2, base: 69.7, meta: 76.5 },
  { label: 'Intention', definition: 'Identify the action an agent plans or means to perform.', human: 90.4, base: 84.7, meta: 84.3 },
  { label: 'Knowledge', definition: 'Track what an agent has or has not learned from observation.', human: 82.2, base: 52.1, meta: 68.2 },
  { label: 'Belief', definition: 'Represent an agent’s world model, including false beliefs.', human: 89.3, base: 82.8, meta: 88.6 },
  { label: 'Communication', definition: 'Resolve implied meaning and pragmatic intent in language.', human: 89.0, base: 84.0, meta: 88.5 }
] as const;
const position = (value: number) => `${Math.max(0, Math.min(100, (value - 50) * 2))}%`;
---

<figure class="essay-figure native-figure full-bleed capability-visual">
  <div class="profile-shell">
    <header>
      <div><span>ToMBench / six-dimensional profile</span><strong>Where does structured inference help?</strong></div>
      <div class="profile-legend" aria-label="Legend"><i class="base"></i>GPT-4 base <i class="meta"></i>+ MetaMind <i class="human"></i>Human reference</div>
    </header>

    <div class="scale" aria-hidden="true"><span>50</span><span>60</span><span>70</span><span>80</span><span>90</span><span>100</span></div>

    <div class="dimension-list">
      {dimensions.map((dimension) => {
        const delta = dimension.meta - dimension.base;
        return (
          <article class:list={['dimension-row', dimension.label === 'Knowledge' && 'is-highlight']}>
            <div class="dimension-label"><strong>{dimension.label}</strong><p>{dimension.definition}</p></div>
            <div class="dimension-track" title={`${dimension.label}: GPT-4 ${dimension.base}, MetaMind ${dimension.meta}, human ${dimension.human}`}>
              <i class="grid-lines" aria-hidden="true"></i>
              <span class="range" style={`--from:${position(dimension.base)};--to:${position(dimension.meta)}`}></span>
              <i class="marker base" style={`left:${position(dimension.base)}`}><b>{dimension.base.toFixed(1)}</b></i>
              <i class="marker meta" style={`left:${position(dimension.meta)}`}><b>{dimension.meta.toFixed(1)}</b></i>
              <i class="marker human" style={`left:${position(dimension.human)}`}><b>{dimension.human.toFixed(1)}</b></i>
            </div>
            <div class:list={['dimension-delta', delta < 0 && 'negative']}><span>Δ</span><strong>{delta >= 0 ? '+' : ''}{delta.toFixed(1)}</strong></div>
          </article>
        );
      })}
    </div>

    <footer>
      <div><span>Largest repair</span><strong>Knowledge state · +16.1</strong></div>
      <div><span>Near ceiling</span><strong>Intention · −0.4</strong></div>
      <p>Scale begins at 50 to make within-dimension movement legible; all labels retain the paper’s reported values.</p>
    </footer>
  </div>
  <figcaption><strong>Capability profile.</strong> The average gain conceals a diagnostic pattern: MetaMind primarily repairs knowledge-state tracking—the weakest base capability—while barely changing intention, where GPT-4 already approaches the human reference. This is more consistent with targeted cognitive support than with a uniform prompting uplift.</figcaption>
</figure>

<style>
  .capability-visual { padding: 0 !important; background: transparent !important; border: 0 !important; }
  .profile-shell { padding: clamp(22px,3.2vw,42px); color: #edf7f5; background: #071c24; border: 1px solid #173e48; box-shadow: 0 28px 70px rgba(7,20,30,.16); font-family: var(--sans); }
  header { padding-bottom: 25px; display: flex; align-items: end; justify-content: space-between; gap: 28px; border-bottom: 1px solid rgba(255,255,255,.17); }
  header > div:first-child { display: grid; gap: 8px; }
  header span, footer span { color: #78949a; font-size: .56rem; font-weight: 780; letter-spacing: .1em; text-transform: uppercase; }
  header strong { font: 410 clamp(1.5rem,3vw,2.7rem)/1.05 var(--serif); letter-spacing: -.025em; }
  .profile-legend { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 8px 13px; color: #9db1b5; font-size: .54rem; }
  .profile-legend i { width: 18px; height: 3px; align-self: center; }
  .profile-legend .base { background: #718b93; }
  .profile-legend .meta { background: #50d7c8; }
  .profile-legend .human { height: 0; border-top: 2px dashed #eef4f3; }
  .scale { margin: 27px 72px 8px min(270px,27%); display: grid; grid-template-columns: repeat(6,1fr); color: #5e7c83; font-size: .5rem; }
  .scale span:last-child { text-align: right; }
  .dimension-list { border-top: 1px solid #23444d; }
  .dimension-row { min-height: 104px; padding: 15px 0; display: grid; grid-template-columns: minmax(200px,27%) minmax(340px,1fr) 58px; gap: 24px; align-items: center; border-bottom: 1px solid #23444d; }
  .dimension-row.is-highlight { margin-right: -14px; margin-left: -14px; padding-right: 14px; padding-left: 14px; background: rgba(80,215,200,.06); box-shadow: inset 3px 0 #50d7c8; }
  .dimension-label strong { color: #e8f1f0; font: 470 1.12rem/1.1 var(--serif); }
  .dimension-label p { margin: 7px 0 0; color: #7f999f; font-size: .54rem; line-height: 1.45; }
  .dimension-track { position: relative; height: 48px; }
  .grid-lines { position: absolute; inset: 0; display: block; background: repeating-linear-gradient(90deg,#294851 0 1px,transparent 1px 20%); border-bottom: 1px solid #456069; }
  .range { position: absolute; top: 22px; left: min(var(--from),var(--to)); width: max(3px,calc(max(var(--from),var(--to)) - min(var(--from),var(--to)))); height: 5px; background: #50d7c8; box-shadow: 0 0 14px rgba(80,215,200,.25); }
  .marker { position: absolute; top: 18px; width: 12px; height: 12px; display: block; border-radius: 50%; transform: translateX(-50%); }
  .marker b { position: absolute; left: 50%; color: #a8bdc1; font: 700 .49rem/1 var(--sans); transform: translate(-50%,-18px); }
  .marker.base { background: #718b93; border: 2px solid #071c24; }
  .marker.meta { z-index: 2; background: #50d7c8; border: 2px solid #071c24; }
  .marker.meta b { color: #50d7c8; transform: translate(-50%,20px); }
  .marker.human { width: 11px; height: 11px; background: #071c24; border: 2px solid #eef4f3; }
  .marker.human b { color: #eef4f3; transform: translate(-50%,-18px); }
  .dimension-delta { text-align: right; }
  .dimension-delta span { display: block; color: #638087; font-size: .48rem; }
  .dimension-delta strong { color: #50d7c8; font: 470 1.02rem/1 var(--serif); }
  .dimension-delta.negative strong { color: #ffbe5c; }
  footer { padding-top: 24px; display: grid; grid-template-columns: .8fr .7fr 1.5fr; gap: 24px; align-items: start; }
  footer div { display: grid; gap: 7px; }
  footer strong { color: #edf7f5; font: 470 1rem/1.1 var(--serif); }
  footer p { margin: 0; color: #78949a; font-size: .54rem; line-height: 1.5; }
  @media (max-width: 800px) {
    header, footer { align-items: start; flex-direction: column; grid-template-columns: 1fr; }
    .profile-legend { justify-content: flex-start; }
    .scale { display: none; }
    .dimension-row { grid-template-columns: 1fr 46px; gap: 12px; }
    .dimension-track { grid-column: 1 / -1; min-width: 0; }
  }
</style>
