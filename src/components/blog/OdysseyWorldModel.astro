<div class="world-model" role="img" aria-label="Physical and cognitive state converge in a causal model that branches into three possible futures.">
  <header><span>Coupled world model</span><strong>The same scene permits different futures.</strong></header>

  <div class="state-pair">
    <article><b>Physical state</b><strong>What can happen</strong><span>wind · distance · terrain</span></article>
    <article><b>Cognitive state</b><strong>What becomes possible</strong><span>belief · desire · relationship</span></article>
  </div>

  <div class="causal-core"><i></i><strong>simulate</strong></div>

  <div class="future-branches">
    <article><b>01</b><strong>Immediate reward</strong></article>
    <article class="is-selected"><b>02</b><strong>Mission preserved</strong></article>
    <article><b>03</b><strong>Unmodeled drift</strong></article>
  </div>

  <footer><span>observe</span><i>→</i><span>infer</span><i>→</i><span>simulate</span><i>→</i><strong>choose</strong></footer>
</div>

<style>
  .world-model { --ink: #121716; --paper: #f3f0e8; --aqua: #16a7a7; --gold: #d69b3d; position: relative; min-height: 600px; padding: clamp(28px,4vw,56px); overflow: hidden; color: var(--ink); background: #edf0e8; border-top: 1px solid var(--ink); border-bottom: 1px solid var(--ink); font-family: var(--sans); isolation: isolate; }
  header { display: grid; grid-template-columns: 180px 1fr; gap: 24px; align-items: baseline; }
  header span { color: #61706c; font-size: .56rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
  header strong { font-family: var(--serif); font-size: clamp(2rem,4.2vw,4rem); font-weight: 430; line-height: .95; letter-spacing: -.035em; }
  .state-pair { position: relative; max-width: 820px; margin: clamp(48px,7vw,82px) auto 0; display: grid; grid-template-columns: 1fr 1fr; gap: clamp(60px,12vw,160px); }
  .state-pair::before, .state-pair::after { content: ''; position: absolute; z-index: -1; top: 100%; width: 43%; height: 90px; border-bottom: 1px solid rgba(18,23,22,.3); }
  .state-pair::before { left: 7%; border-right: 1px solid rgba(18,23,22,.3); transform: skewY(14deg); }
  .state-pair::after { right: 7%; border-left: 1px solid rgba(18,23,22,.3); transform: skewY(-14deg); }
  .state-pair article { position: relative; padding: 0 0 22px 25px; border-left: 1px solid rgba(18,23,22,.3); }
  .state-pair article::before { content: ''; position: absolute; top: 0; left: -7px; width: 11px; height: 11px; background: #edf0e8; border: 2px solid var(--aqua); border-radius: 50%; box-shadow: 0 0 0 8px rgba(22,167,167,.08); animation: model-node 3.5s ease-in-out infinite; }
  .state-pair article:nth-child(2)::before { border-color: var(--gold); animation-delay: -1.7s; }
  .state-pair b { color: var(--aqua); font-size: .54rem; letter-spacing: .1em; text-transform: uppercase; }
  .state-pair strong { margin-top: 42px; display: block; font: 470 clamp(1.3rem,2.4vw,2rem)/1.05 var(--serif); }
  .state-pair span { margin-top: 10px; display: block; color: #5a6662; font-size: .58rem; font-weight: 700; }
  .causal-core { position: relative; z-index: 2; width: 110px; height: 110px; margin: 72px auto 65px; display: grid; place-items: center; align-content: center; gap: 9px; color: #fff; background: var(--ink); border-radius: 50%; }
  .causal-core::before { content: ''; position: absolute; inset: -17px; border: 1px solid rgba(18,23,22,.28); border-radius: 50%; animation: model-orbit 10s linear infinite; }
  .causal-core i { width: 8px; height: 8px; background: var(--gold); border-radius: 50%; box-shadow: 0 0 0 8px rgba(214,155,61,.13); animation: model-core 2.7s ease-in-out infinite; }
  .causal-core strong { font-size: .52rem; letter-spacing: .12em; text-transform: uppercase; }
  .future-branches { position: relative; display: grid; grid-template-columns: repeat(3,1fr); gap: clamp(25px,5vw,70px); }
  .future-branches::before { content: ''; position: absolute; z-index: -1; top: -33px; right: 12%; left: 12%; height: 33px; border-top: 1px solid rgba(18,23,22,.3); border-right: 1px solid rgba(18,23,22,.3); border-left: 1px solid rgba(18,23,22,.3); }
  .future-branches article { position: relative; min-height: 120px; padding: 24px 0 0; border-top: 1px solid rgba(18,23,22,.28); }
  .future-branches article::before { content: ''; position: absolute; top: -39px; left: 50%; width: 1px; height: 38px; background: rgba(18,23,22,.3); }
  .future-branches b { color: var(--aqua); font-size: .56rem; letter-spacing: .1em; }
  .future-branches strong { margin-top: 25px; display: block; font: 470 clamp(1.1rem,1.9vw,1.55rem)/1.05 var(--serif); }
  .future-branches .is-selected { color: #fff; margin-top: -13px; padding: 24px; background: var(--ink); border-top-color: var(--gold); }
  .future-branches .is-selected b { color: var(--gold); }
  footer { margin-top: 36px; padding-top: 20px; display: flex; justify-content: center; flex-wrap: wrap; gap: 12px; border-top: 1px solid rgba(18,23,22,.24); font: 700 .58rem/1 var(--sans); letter-spacing: .08em; text-transform: uppercase; }
  footer i { color: var(--aqua); font-style: normal; }
  footer strong { color: #9d6414; }
  @keyframes model-node { 50% { transform: scale(1.3); box-shadow: 0 0 0 13px rgba(22,167,167,.03); } }
  @keyframes model-core { 50% { transform: scale(1.3); } }
  @keyframes model-orbit { to { transform: rotate(360deg); } }
  @media (max-width: 720px) {
    header { grid-template-columns: 1fr; }
    .state-pair, .future-branches { grid-template-columns: 1fr; gap: 25px; }
    .state-pair::before, .state-pair::after, .future-branches::before, .future-branches article::before { display: none; }
    .causal-core { margin: 45px auto; }
    .future-branches .is-selected { margin-top: 0; }
  }
</style>
