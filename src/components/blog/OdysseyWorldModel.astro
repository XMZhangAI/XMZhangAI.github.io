<div class="world-model" data-world-model>
  <header><span>Coupled world model</span><strong>The same scene permits different futures.</strong></header>
  <div class="model-modes" role="group" aria-label="Compare physical-only and coupled cognitive world models">
    <button data-mode="physical" aria-pressed="false"><b>Before</b><strong>Physical prediction</strong><span>movement and contact</span></button>
    <button class="is-active" data-mode="coupled" aria-pressed="true"><b>After</b><strong>Coupled cognition</strong><span>meaning and consequence</span></button>
  </div>
  <div class="model-stage">
    <canvas data-world-canvas aria-hidden="true"></canvas>
    <section class="inputs" aria-label="State inputs">
      <article class="state-card physical" data-flow-node><b>Physical state</b><strong>What can happen</strong><span>wind · distance · terrain</span></article>
      <article class="state-card cognitive" data-flow-node><b>Cognitive state</b><strong>What becomes possible</strong><span>belief · desire · relationship</span></article>
    </section>
    <div class="causal-core" data-flow-node><i></i><strong>Causal model</strong><span>roll forward</span></div>
    <section class="futures" aria-label="Simulated futures">
      <button data-flow-node data-future="reward" data-now="Locally attractive action" data-later="Trust decays; mission risk rises" aria-pressed="false"><b>01</b><strong>Immediate reward</strong><span>short horizon</span></button>
      <button class="is-selected" data-flow-node data-future="mission" data-now="Bounded cost is accepted" data-later="Goal and relationship remain coherent" aria-pressed="true"><b>02</b><strong>Mission preserved</strong><span>selected future</span></button>
      <button data-flow-node data-future="drift" data-now="State is incompletely modeled" data-later="Outcome remains uncertain" aria-pressed="false"><b>03</b><strong>Unmodeled drift</strong><span>uncertainty branch</span></button>
    </section>
  </div>
  <div class="future-readout" aria-live="polite"><span><b>Now</b><strong data-now>Bounded cost is accepted</strong></span><i>→</i><span><b>Later</b><strong data-later>Goal and relationship remain coherent</strong></span></div>
  <footer><span>observe</span><i>→</i><span>infer hidden state</span><i>→</i><span>simulate branches</span><i>→</i><strong>choose</strong></footer>
</div>

<script>
  // @ts-nocheck -- Canvas connections are calculated from live DOM geometry.
  document.querySelectorAll('[data-world-model]').forEach((root) => {
    const stage=root.querySelector('.model-stage'); const canvas=root.querySelector('[data-world-canvas]');
    const inputNodes=[...root.querySelectorAll('.inputs [data-flow-node]')]; const core=root.querySelector('.causal-core'); const futureNodes=[...root.querySelectorAll('.futures [data-flow-node]')];
    if(!(stage instanceof HTMLElement)||!(canvas instanceof HTMLCanvasElement)||!(core instanceof HTMLElement))return;
    const ctx=canvas.getContext('2d');if(!ctx)return;let frame=0;const started=performance.now();const reduceMotion=matchMedia('(prefers-reduced-motion: reduce)').matches;
    const center=(el,box,side='center')=>{const r=el.getBoundingClientRect();return{x:(side==='right'?r.right:side==='left'?r.left:r.left+r.width/2)-box.left,y:r.top-box.top+r.height/2}};
    const curve=(a,b,color,dash=false)=>{ctx.beginPath();ctx.moveTo(a.x,a.y);const dx=(b.x-a.x)*.5;ctx.bezierCurveTo(a.x+dx,a.y,b.x-dx,b.y,b.x,b.y);ctx.strokeStyle=color;ctx.lineWidth=1.5;ctx.setLineDash(dash?[5,6]:[]);ctx.stroke();ctx.setLineDash([])};
    const draw=(now=performance.now())=>{const box=stage.getBoundingClientRect(),ratio=Math.min(devicePixelRatio||1,2);canvas.width=Math.round(box.width*ratio);canvas.height=Math.round(box.height*ratio);canvas.style.width=`${box.width}px`;canvas.style.height=`${box.height}px`;ctx.setTransform(ratio,0,0,ratio,0,0);ctx.clearRect(0,0,box.width,box.height);const cL=center(core,box,'left'),cR=center(core,box,'right'),physicalOnly=root.classList.contains('is-physical-only');inputNodes.forEach((n,i)=>{if(!physicalOnly||i===0)curve(center(n,box,'right'),cL,'rgba(13,152,156,.52)')});futureNodes.forEach((n,i)=>curve(cR,center(n,box,'left'),physicalOnly?(i===0?'rgba(200,138,42,.9)':'rgba(18,23,22,.2)'):(i===1?'rgba(200,138,42,.9)':'rgba(13,152,156,.42)'),physicalOnly?i!==0:i===2));const selected=futureNodes.find(n=>n.classList.contains('is-selected'))||futureNodes[1];const a=cR,b=center(selected,box,'left');const t=reduceMotion?1:((now-started)%4200)/4200;const x=a.x+(b.x-a.x)*t,y=a.y+(b.y-a.y)*t;ctx.fillStyle='#c88a2a';ctx.shadowColor='rgba(200,138,42,.8)';ctx.shadowBlur=14;ctx.beginPath();ctx.arc(x,y,4,0,Math.PI*2);ctx.fill();ctx.shadowBlur=0;if(!reduceMotion)frame=requestAnimationFrame(draw)};
    const observer=new ResizeObserver(()=>draw());observer.observe(stage);draw();
    futureNodes.forEach(button=>button.addEventListener('click',()=>{futureNodes.forEach(n=>{n.classList.remove('is-selected');n.setAttribute('aria-pressed','false')});button.classList.add('is-selected');button.setAttribute('aria-pressed','true');const now=root.querySelector('[data-now]:not(button)'),later=root.querySelector('[data-later]:not(button)');if(now)now.textContent=button.dataset.now||'';if(later)later.textContent=button.dataset.later||'';}));
    const modeButtons=[...root.querySelectorAll('[data-mode]')];
    modeButtons.forEach(button=>button.addEventListener('click',()=>{const physical=button.dataset.mode==='physical';root.classList.toggle('is-physical-only',physical);modeButtons.forEach(item=>{const active=item===button;item.classList.toggle('is-active',active);item.setAttribute('aria-pressed',String(active))});const target=physical?futureNodes[0]:futureNodes[1];target?.click();const now=root.querySelector('[data-now]:not(button)'),later=root.querySelector('[data-later]:not(button)');if(physical){if(now)now.textContent='Movement and contact are predicted';if(later)later.textContent='Meaning and social consequence stay invisible';}}));
    document.addEventListener('astro:before-swap',()=>{cancelAnimationFrame(frame);observer.disconnect()},{once:true});
  });
</script>

<style>
  .world-model{--ink:#121716;--paper:#f3f0e8;--cyan:#0d989c;--gold:#c88a2a;position:relative;padding:clamp(28px,4vw,56px);overflow:hidden;color:var(--ink);background:#edf0e8;border-block:1px solid var(--ink);font-family:var(--sans)}header{display:grid;grid-template-columns:180px 1fr;gap:24px;align-items:baseline}header span{color:#61706c;font-size:.56rem;font-weight:800;letter-spacing:.12em;text-transform:uppercase}header strong{font:430 clamp(2rem,4.2vw,4rem)/.95 var(--serif);letter-spacing:-.035em}
  .model-modes{margin:38px 0 0 204px;display:grid;grid-template-columns:repeat(2,minmax(0,260px));gap:1px;background:rgba(18,23,22,.24);border:1px solid rgba(18,23,22,.24)}.model-modes button{padding:15px 18px;display:grid;grid-template-columns:auto 1fr;gap:4px 12px;color:#56615e;background:#edf0e8;border:0;font:inherit;cursor:pointer;text-align:left}.model-modes button b{grid-row:1/3;color:#7b8581;font-size:.5rem;letter-spacing:.09em;text-transform:uppercase}.model-modes button strong{font:470 1rem/1 var(--serif)}.model-modes button span{font-size:.53rem;font-weight:700}.model-modes button.is-active{color:#fff;background:var(--ink)}.model-modes button.is-active b{color:var(--gold)}.model-modes button.is-active span{color:#b8c7c4}
  .model-stage{position:relative;min-height:500px;margin-top:34px;display:grid;grid-template-columns:minmax(190px,1fr) 150px minmax(220px,1.1fr);gap:clamp(34px,7vw,100px);align-items:center}.model-stage canvas{position:absolute;inset:0;z-index:0;pointer-events:none}.inputs,.futures{position:relative;z-index:2;display:grid;gap:18px}.state-card,.futures button{position:relative;padding:20px 22px;display:grid;gap:9px;color:var(--ink);background:rgba(255,253,247,.88);border:1px solid rgba(18,23,22,.25);text-align:left}.state-card::after,.futures button::before{content:'';position:absolute;top:50%;width:10px;height:10px;background:#edf0e8;border:2px solid var(--cyan);border-radius:50%;transform:translateY(-50%)}.state-card::after{right:-7px}.futures button::before{left:-7px}.state-card b,.futures b{color:#087a7d;font-size:.52rem;letter-spacing:.1em;text-transform:uppercase}.state-card strong,.futures strong{font:470 clamp(1.12rem,2vw,1.55rem)/1.05 var(--serif)}.state-card span,.futures span{color:#66736f;font-size:.58rem;font-weight:700}.cognitive::after{border-color:var(--gold)}.is-physical-only .cognitive{opacity:.28}.is-physical-only .futures button:not(:first-child){opacity:.42}
  .causal-core{position:relative;z-index:3;width:140px;height:140px;display:grid;place-items:center;align-content:center;gap:8px;color:#fff;background:var(--ink);border-radius:50%;box-shadow:0 0 0 16px rgba(13,152,156,.06),0 0 60px rgba(13,152,156,.14)}.causal-core i{width:8px;height:8px;background:var(--gold);border-radius:50%;box-shadow:0 0 0 8px rgba(200,138,42,.14);animation:model-core 2.5s ease-in-out infinite}.causal-core strong{font:470 1rem/1 var(--serif)}.causal-core span{color:#b8c8c5;font-size:.45rem;font-weight:800;letter-spacing:.1em;text-transform:uppercase}.futures button{font:inherit;cursor:pointer;transition:background .2s,color .2s,transform .2s}.futures button:hover,.futures button:focus-visible{transform:translateX(4px);outline:none}.futures button.is-selected{color:#fff;background:var(--ink);border-color:var(--gold)}.futures button.is-selected::before{background:var(--gold);border-color:#fff}.futures button.is-selected b{color:var(--gold)}.futures button.is-selected span{color:#bdd0cc}.futures button:last-child{border-style:dashed}
  .future-readout{padding:22px 0;display:grid;grid-template-columns:1fr auto 1fr;gap:24px;align-items:center;border-block:1px solid rgba(18,23,22,.24)}.future-readout span{display:grid;gap:7px}.future-readout span:last-child{text-align:right}.future-readout b{color:#087a7d;font-size:.53rem;letter-spacing:.1em;text-transform:uppercase}.future-readout strong{font:470 clamp(1rem,1.8vw,1.4rem)/1.1 var(--serif)}.future-readout i{color:var(--gold);font-style:normal}footer{padding-top:20px;display:flex;justify-content:center;flex-wrap:wrap;gap:12px;font-size:.58rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase}footer i{color:var(--cyan);font-style:normal}footer strong{color:#98620d}@keyframes model-core{50%{transform:scale(1.35)}}
  @media(max-width:760px){header{grid-template-columns:1fr}.model-modes{margin-left:0;grid-template-columns:1fr}.model-stage{min-height:auto;grid-template-columns:1fr}.model-stage canvas{display:none}.causal-core{margin:auto}.state-card::after,.futures button::before{display:none}.future-readout{grid-template-columns:1fr}.future-readout span:last-child{text-align:left}.future-readout i{transform:rotate(90deg)}}
</style>
