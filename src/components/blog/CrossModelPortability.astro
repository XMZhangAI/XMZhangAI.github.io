---
const original = [
  ['ChatGLM3–6B', 37.3, 47.5], ['LLaMA2–13B', 45.7, 53.4],
  ['Baichuan2–13B', 45.4, 47.0], ['Mistral–7B', 51.3, 58.2],
  ['Mistral–8×7B', 50.8, 52.0], ['Qwen–14B', 54.8, 59.4],
  ['GPT–3.5 / 0613', 57.4, 64.2], ['GPT–3.5 / 1106', 58.7, 65.1],
  ['GPT–4 / 0613', 67.3, 76.2], ['GPT–4 / 1106', 74.8, 81.0]
] as const;
const advanced = [
  ['Claude 3.5 Sonnet', 70.7, 81.0], ['DeepSeek–R1', 86.0, 88.6],
  ['OpenAI o1', 88.6, 90.3], ['OpenAI o3', 90.3, 92.2]
] as const;
const x = (value: number) => `${Math.max(0, Math.min(100, ((value - 30) / 65) * 100))}%`;
---

<figure class="essay-figure native-figure full-bleed portability-visual">
  <div class="chart-shell">
    <header class="visual-head">
      <div><span>14 paired comparisons / 16+ models evaluated overall</span><strong>One architecture. Fourteen directly comparable backbones.</strong></div>
      <div class="legend"><i class="base"></i>Base <i class="meta"></i>+ MetaMind</div>
    </header>

    <section class="chart-panel" aria-labelledby="original-models">
      <div class="panel-title"><strong id="original-models">Original cross-family evaluation</strong><span>Figure 2 · 10 backbones</span></div>
      <div class="axis" aria-hidden="true"><span>30</span><span>50</span><span>70</span><span>90</span><span>95</span></div>
      <div class="rows">
        {original.map(([model, base, meta]) => (
          <div class="model-row">
            <span class="model">{model}</span>
            <div class="bars" title={`${model}: ${base} to ${meta}`}>
              <i class="bar-base" style={`width:${x(base)}`}></i>
              <i class="bar-meta" style={`width:${x(meta)}`}></i>
              <b style={`left:${x(meta)}`}>{meta.toFixed(1)}</b>
            </div>
            <strong>+{(meta - base).toFixed(1)}</strong>
          </div>
        ))}
      </div>
    </section>

    <section class="chart-panel advanced" aria-labelledby="advanced-models">
      <div class="panel-title"><strong id="advanced-models">Advanced reasoning extension</strong><span>Table 6 · high-baseline systems</span></div>
      <div class="rows">
        {advanced.map(([model, base, meta]) => (
          <div class="model-row">
            <span class="model">{model}</span>
            <div class="bars" title={`${model}: ${base} to ${meta}`}>
              <i class="bar-base" style={`width:${x(base)}`}></i>
              <i class="bar-meta" style={`width:${x(meta)}`}></i>
              <b style={`left:${x(meta)}`}>{meta.toFixed(1)}</b>
            </div>
            <strong>+{(meta - base).toFixed(1)}</strong>
          </div>
        ))}
      </div>
    </section>

    <footer><span>Figure 2 + Table 6 · scale begins at 30 to reveal within-model change.</span><strong>14 / 14 paired comparisons improve</strong></footer>
  </div>
  <figcaption><strong>Cross-model portability.</strong> The complete study evaluates more than 16 models; this figure shows the 14 with directly paired ToMBench values. Every paired comparison improves. Gains narrow as the unassisted model approaches the benchmark ceiling—yet remain positive for o1 (+1.7) and o3 (+1.9)—which separates a persistent systems effect from a result tied to one model family.</figcaption>
</figure>

<style>
  .portability-visual { padding: 0 !important; background: transparent !important; border: 0 !important; }
  .chart-shell { padding: clamp(22px, 3.2vw, 42px); color: #eff6f5; background: #071c24; border: 1px solid #173e48; box-shadow: 0 28px 70px rgba(7,20,30,.16); font-family: var(--sans); }
  .visual-head { padding-bottom: 25px; display: flex; align-items: end; justify-content: space-between; gap: 30px; border-bottom: 1px solid rgba(255,255,255,.17); }
  .visual-head > div:first-child { display: grid; gap: 8px; }
  .visual-head span, .panel-title span, footer span { color: #78949a; font-size: .56rem; font-weight: 760; letter-spacing: .1em; text-transform: uppercase; }
  .visual-head strong { font-family: var(--serif); font-size: clamp(1.5rem, 3vw, 2.7rem); font-weight: 410; line-height: 1.06; letter-spacing: -.025em; }
  .legend { display: flex; align-items: center; gap: 8px; color: #a7bbbf; font-size: .57rem; white-space: nowrap; }
  .legend i { width: 24px; height: 4px; display: inline-block; }
  .legend .base { background: #42606a; }
  .legend .meta { background: #50d7c8; }
  .chart-panel { margin-top: 28px; padding: 24px; background: #0b2730; border: 1px solid #1b4650; }
  .panel-title { margin-bottom: 18px; display: flex; justify-content: space-between; gap: 20px; }
  .panel-title strong { color: #dce9e8; font-size: .67rem; letter-spacing: .06em; text-transform: uppercase; }
  .axis { margin-left: 158px; padding-bottom: 8px; display: grid; grid-template-columns: repeat(5,1fr); color: #607f86; border-bottom: 1px solid #254650; font-size: .5rem; }
  .axis span:last-child { text-align: right; }
  .rows { display: grid; gap: 10px; }
  .model-row { min-height: 27px; display: grid; grid-template-columns: 142px minmax(160px,1fr) 42px; gap: 16px; align-items: center; }
  .model { color: #a9bec1; font-size: .57rem; }
  .bars { position: relative; height: 21px; background: repeating-linear-gradient(90deg, rgba(255,255,255,.045) 0 1px, transparent 1px 25%); border-left: 1px solid #49636a; }
  .bars i { position: absolute; left: 0; display: block; }
  .bar-base { top: 4px; height: 13px; background: #42606a; }
  .bar-meta { top: 8px; height: 5px; background: #50d7c8; box-shadow: 0 0 16px rgba(80,215,200,.3); }
  .bars b { position: absolute; top: 1px; transform: translateX(7px); color: #dff8f4; font-size: .52rem; font-weight: 740; }
  .model-row > strong { color: #50d7c8; font: 500 .82rem/1 var(--serif); text-align: right; }
  .advanced { background: #0d3037; }
  footer { margin-top: 22px; padding-top: 18px; display: flex; justify-content: space-between; gap: 20px; border-top: 1px solid rgba(255,255,255,.17); }
  footer strong { color: #50d7c8; font-size: .58rem; letter-spacing: .07em; text-transform: uppercase; }
  @media (max-width: 700px) {
    .visual-head, .panel-title, footer { align-items: start; flex-direction: column; }
    .chart-shell { padding: 20px 14px; }
    .chart-panel { width: 100%; max-width: 100%; padding: 18px 12px; overflow: hidden; }
    .axis, .rows { width: 100%; min-width: 0; }
    .axis { margin-left: 96px; grid-template-columns: repeat(5,minmax(0,1fr)); }
    .model-row { grid-template-columns: 82px minmax(0,1fr) 34px; gap: 8px; }
    .model { font-size: .5rem; line-height: 1.25; overflow-wrap: anywhere; }
    .bars b { display: none; }
    .model-row > strong { font-size: .72rem; }
  }
</style>
