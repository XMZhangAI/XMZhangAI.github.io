  .architecture-dashboard{margin-top:34px;display:grid;grid-template-columns:minmax(0,1.35fr) minmax(290px,.8fr);gap:1px;background:var(--ink);border-block:1px solid var(--ink)}.feature-panel,.detail-stack{background:#f4f1e9}.feature-panel{padding:28px}.panel-label{display:flex;justify-content:space-between;color:#65716d;font-size:.53rem;font-weight:800;letter-spacing:.1em;text-transform:uppercase}.panel-label span{color:var(--cyan)}
  .module-grid{position:relative;margin-top:28px;display:grid;grid-template-columns:repeat(2,1fr);gap:1px;background:rgba(21,26,25,.18);border:1px solid rgba(21,26,25,.18)}.module{position:relative;min-height:108px;padding:18px 18px 16px 42px;display:grid;grid-template-columns:auto 1fr;align-content:center;gap:5px 12px;color:var(--ink);background:#f4f1e9;border:0;font:inherit;cursor:pointer;text-align:left;transition:background .18s,color .18s}.module i{position:absolute;top:50%;left:17px;width:11px;height:11px;border:2px solid currentColor;border-radius:50%;transform:translateY(-50%)}.module b{color:#75817d;font-size:.48rem;letter-spacing:.09em}.module strong{font:470 clamp(1.12rem,1.9vw,1.5rem)/1 var(--serif)}.module span{grid-column:2;color:currentColor;font-size:.47rem;font-weight:800;letter-spacing:.09em;text-transform:uppercase}.module:hover,.module:focus-visible{z-index:2;background:#fffdf7;outline:1px solid currentColor}.module.is-active{z-index:3;color:#fff;background:var(--ink);outline:1px solid var(--ink)}.module.is-active i{background:currentColor;box-shadow:0 0 0 7px color-mix(in srgb,currentColor 12%,transparent)}.module.is-active b,.module.is-active span{color:#b8c5c1}.family-scaffold{color:var(--cyan)}.family-pattern{color:var(--violet)}.family-state{color:var(--rose)}.family-policy{color:var(--gold)}
  .detail-stack{position:relative;min-height:410px;padding:48px 38px;display:grid;place-items:center;overflow:hidden}.stack-sheet,.detail-card{position:absolute;width:calc(100% - 92px);height:calc(100% - 112px);border:1px solid rgba(21,26,25,.2);background:#ebe9e1}.stack-sheet:first-child{transform:translate(16px,-16px)}.stack-sheet:nth-child(2){transform:translate(8px,-8px);background:#f0ede5}.detail-card{z-index:2;padding:30px;display:flex;flex-direction:column;background:#fffdf7;box-shadow:0 18px 38px rgba(21,26,25,.08)}.detail-head{display:flex;justify-content:space-between;color:var(--cyan);font-size:.55rem;font-weight:800;letter-spacing:.1em;text-transform:uppercase}.detail-head b{color:#8a9490}.detail-card>strong{margin-top:auto;font:470 clamp(1.8rem,3vw,2.7rem)/.95 var(--serif)}.detail-card p{margin:14px 0 0;color:#52605c;font-size:.7rem;line-height:1.55}.coordination-mark{margin-top:auto;padding:13px 0;display:grid;grid-template-columns:1fr auto 1fr;gap:12px;align-items:center;color:#61706b;font-size:.5rem;font-weight:800;letter-spacing:.1em;text-transform:uppercase}.coordination-mark i{height:1px;background:rgba(21,26,25,.24)}.detail-card small{color:#78827f;font-size:.54rem;line-height:1.45}
  .family-map{margin-top:30px;display:grid;grid-template-columns:repeat(4,1fr);gap:15px}.family-map span{padding-top:11px;border-top:2px solid currentColor;font-size:.55rem;line-height:1.4}.family-map b{display:block;font-size:.56rem;letter-spacing:.08em;text-transform:uppercase}
  @keyframes rail-travel{0%{left:1%;opacity:0}12%,88%{opacity:1}100%{left:99%;opacity:0}}
  @media(max-width:760px){header{grid-template-columns:1fr}.system-rail{grid-template-columns:1fr}.system-rail b{display:none}.system-rail>span:last-of-type{justify-self:start}.architecture-dashboard{grid-template-columns:1fr}.module-grid{grid-template-columns:1fr}.detail-stack{min-height:360px}.family-map{grid-template-columns:1fr 1fr}}
</style>
