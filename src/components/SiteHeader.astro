---
const { active = '' } = Astro.props;
---

<div class="read-progress" aria-hidden="true"><span data-read-progress></span></div>
<header class="site-header" data-site-header>
  <a class="brand" href="/" aria-label="Worldeology Lab — home">
    <span class="brand-mark world-mark" aria-hidden="true">W</span>
    <span class="brand-type"><strong>Worldeology Lab</strong><small>Cognitive AI Research</small></span>
  </a>

  <button class="menu-button" type="button" aria-expanded="false" aria-controls="site-menu" data-menu-button>
    <span class="sr-only">Open menu</span><i></i><i></i>
  </button>

  <nav id="site-menu" class="site-menu" aria-label="Primary navigation" data-site-menu>
    <a class:list={[active === 'research' && 'is-active']} href="/research/">Research</a>
    <a class:list={[active === 'work' && 'is-active']} href="/#work">Work</a>
    <a class:list={[active === 'people' && 'is-active']} href="/people/">People</a>
    <a class:list={[active === 'about' && 'is-active']} href="/about/">About</a>
    <a class="menu-cv" href="mailto:xuanmingdi.zxm@alibaba-inc.com?subject=Worldeology%20Lab">Contact <span aria-hidden="true">↗</span></a>
  </nav>
</header>
