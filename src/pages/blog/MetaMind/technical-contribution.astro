      <li class="is-largest" style="--drop:100%"><div><b>Without reflective validation</b></div><i></i><strong>−16.1</strong></li>
      <li style="--drop:62%"><div><b>Without social memory</b></div><i></i><strong>−10.0</strong></li>
    </ol>
