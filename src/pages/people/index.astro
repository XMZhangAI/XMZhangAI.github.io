---
import SiteLayout from '../../layouts/SiteLayout.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import '../../styles/lab.css';
---
<SiteLayout title="People — Worldeology Lab" description="People building the Worldeology Lab research program in Cognitive AI." headerTone="paper" active="people" image="/og.png">
  <main id="main" class="lab-site lab-page">
    <header class="lab-page-hero"><p class="lab-index">Worldeology Lab / People</p><h1>People who<br />follow the trajectory.</h1><p>The lab is being built as a small, research-first group spanning social cognition, metacognitive systems, model mechanisms, and interactive world modeling.</p></header>
    <section class="lab-page-section" aria-labelledby="people-core"><header><p class="lab-index">01 / Core</p><h2 id="people-core">The people building Worldeology.</h2></header>
      <div class="people-grid">
        <article class="person-card member"><img src="/assets/images/xuanming-zhang.webp" width="886" height="886" alt="Xuanming Zhang" /><div><span>Founder · Research</span><h3>Xuanming Zhang</h3><p>Cognitive AI, Theory of Mind, reflective reasoning, inference-time mechanisms, and long-horizon interactive worlds.</p><nav><a href="https://scholar.google.com/citations?user=zP5k9lsAAAAJ">Scholar ↗</a><a href="https://github.com/XMZhangAI">GitHub ↗</a></nav></div></article>
        <article class="person-card member"><img src="https://jewelina95.github.io/JewelinaWen/assets/images/me.jpg" width="800" height="800" alt="Shaoyue Wen" loading="lazy" /><div><span>Research</span><h3>Shaoyue Wen</h3><p>Video reasoning, brain-inspired cognition, adaptive interaction, and embodied healthcare systems.</p><nav><a href="https://jewelina95.github.io/JewelinaWen/">Personal site ↗</a></nav></div></article>
      </div>
    </section>
    <section class="lab-page-section" aria-labelledby="collab-title"><header><p class="lab-index">02 / Collaboration</p><h2 id="collab-title">The field is larger than one institution.</h2></header><div class="lab-prose"><p>Worldeology Lab is designed to collaborate across universities, frontier-model teams, social-science groups, and creative-technology communities. The common requirement is not organizational affiliation; it is a serious interest in how cognition becomes action and how action changes the world.</p></div></section>
    <SiteFooter />
  </main>
</SiteLayout>
