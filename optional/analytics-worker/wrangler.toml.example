name = "xmz-research-analytics"
main = "src/index.ts"
compatibility_date = "2026-07-01"

[[d1_databases]]
binding = "DB"
database_name = "xmz-analytics"
database_id = "REPLACE_WITH_D1_DATABASE_ID"

[vars]
# Comma-separated. Add the custom domain later without removing GitHub Pages.
ALLOWED_ORIGINS = "https://xmzhangai.github.io,http://127.0.0.1:4173,http://localhost:4321"
STORE_RAW_IP = "false"
RETENTION_DAYS = "90"

[triggers]
crons = ["17 3 * * *"]

# Add these with `npx wrangler secret put ...`; never commit their values:
# IP_SALT
# ADMIN_USER
# ADMIN_PASSWORD
